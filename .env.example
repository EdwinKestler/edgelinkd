# n2link environment variables. Copy to .env (git-ignored), fill in what you need, then load it:
#   set -a; . ./.env; set +a
# n2linkd does not read .env by itself. Never commit real values.

# --- Runtime -------------------------------------------------------------------

# Optional. Key that encrypts saved node credentials: 32 random bytes, base64url, no padding.
# Without it the local key file (flows_cred.key) is used. Generate:
#   openssl rand 32 | basenc --base64url | tr -d '='
N2LINK_CREDENTIAL_KEY=

# Only if an `http in` node sets webhook_bearer_env to this name. Any long random string.
N2LINK_WEBHOOK_TOKEN=

# Optional. dev or prod: picks n2linkd.<env>.toml. `cargo run` already uses dev.
N2LINK_RUN_ENV=

# Optional. Home directory (default ~/.n2linkd).
N2LINK_HOME=

# --- Live tests (CI never runs these; each group needs its *_LIVE=1) -------------

# MQTT broker on 127.0.0.1:1883
N2LINK_MQTT_LIVE=
N2LINK_MQTT_USER=
N2LINK_MQTT_PASSWORD=

# Local PostgreSQL, user postgres
N2LINK_POSTGRES_LIVE=
N2LINK_POSTGRES_PASSWORD=

# AI providers (adoption/phase6/LIVE.md). The agent and embedding live tests are still stubs.
N2LINK_AI_LIVE=
N2LINK_OPENAI_API_KEY=
N2LINK_ANTHROPIC_API_KEY=
N2LINK_XAI_API_KEY=
