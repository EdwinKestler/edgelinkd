    "crates/web/client/*.ts",
    "crates/web/client/*.html",
    "crates/web/*-editor/**/*.html",
    "crates/web/public/nodes/**/*.html",
    "node-plugins/**/*.rs",
    "scripts/**/*.py",
    "scripts/**/*.sh"
